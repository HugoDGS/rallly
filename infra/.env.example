# cp .env.example .env puis remplir les secrets (voir README)

# Local : rallly.localhost (résolu automatiquement par le navigateur)
# VM    : <IP_VM>.sslip.io
DOMAIN=rallly.localhost
# 80 sur la VM ; 8080 en local avec Podman/Docker rootless (ports < 1024 interdits)
HTTP_PORT=8080

# Facultatif : derrière un proxy qui termine le HTTPS (VM derrière Cloudflare Tunnel).
# Vides ou absents = comportement local : DOMAIN, auth.DOMAIN, mail.DOMAIN en http://…:HTTP_PORT.
# Noms servis par Caddy
#RALLLY_HOST=rallly-ynov.liliansonzogni.fr
#AUTH_HOST=auth-ynov.liliansonzogni.fr
#MAIL_HOST=mail-ynov.liliansonzogni.fr
# URL vues par le navigateur, sans / final
#RALLLY_PUBLIC_URL=https://rallly-ynov.liliansonzogni.fr
#AUTH_PUBLIC_URL=https://auth-ynov.liliansonzogni.fr
# Proxys dont Caddy garde le X-Forwarded-Proto (syntaxe Caddy : private_ranges, CIDR…)
#TRUSTED_PROXIES=private_ranges

# Image Rallly publiée par la CI (inutile en mode dev, voir compose.dev.yaml)
RALLLY_IMAGE=ghcr.io/hugodgs/rallly:main

# openssl rand -base64 36 | tr -d '\n/+='
PG_PASS=
AUTHENTIK_SECRET_KEY=
RALLLY_SECRET=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_ID=rallly

# Compte akadmin d'Authentik
AUTHENTIK_ADMIN_PASSWORD=
# Mot de passe des comptes de démo (alice, bob, eve)
DEMO_PASSWORD=
